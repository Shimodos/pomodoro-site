<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders the real Pomodoro windows through WPF at 2x resolution for the site.
    Usage: dotnet run - -  <outDir> [scale]
    The app project is referenced from the sibling PomodoroTimer repository.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Snapshot</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\PomodoroTimer\PomodoroTimer.csproj" />
  </ItemGroup>

</Project>
