---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Screenshots from '../components/Screenshots.astro';
import Faq from '../components/Faq.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Pomodoro — a native Pomodoro timer for Windows"
  description="A free, open-source Pomodoro timer for Windows 10 and 11. Native C# / WPF, one small exe: session limit with a real end time, two accent colors, eight sounds, tray, pop-up when a phase ends. No Electron, no install."
>
  <Nav />
  <main>
    <Hero />
    <Why />
    <HowItWorks />
    <Features />
    <Screenshots />
    <Faq />
    <Download />
  </main>
  <Footer />
</Layout>
