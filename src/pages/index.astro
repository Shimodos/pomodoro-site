---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Screenshots from '../components/Screenshots.astro';
import MacShots from '../components/MacShots.astro';
import Faq from '../components/Faq.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Pomodoro — a native Pomodoro timer for Windows and macOS"
  description="A free, open-source Pomodoro timer for Windows 10 / 11 and macOS 13+. Native C# / WPF on Windows, Swift on the Mac: session limit with a real end time, two accent colors, eight sounds, tray or menu bar item, pop-up when a phase ends. No Electron."
>
  <Nav />
  <main>
    <Hero />
    <Why />
    <HowItWorks />
    <Features />
    <Screenshots />
    <MacShots />
    <Faq />
    <Download />
  </main>
  <Footer />
</Layout>
