---
import Shot from './Shot.astro';
import timerLight from '../assets/shots/settings-timer-light.png';
import timerDark from '../assets/shots/settings-timer-dark.png';
import soundLight from '../assets/shots/settings-sound-light.png';
import soundDark from '../assets/shots/settings-sound-dark.png';
import lookLight from '../assets/shots/settings-look-light.png';
import lookDark from '../assets/shots/settings-look-dark.png';
import systemLight from '../assets/shots/settings-system-light.png';
import systemDark from '../assets/shots/settings-system-dark.png';

const pages = [
  { light: timerLight, dark: timerDark, title: 'Timer', text: 'Lengths, sessions before a long break, auto-start rules, the session limit and the planned end time.' },
  { light: soundLight, dark: soundDark, title: 'Sound', text: 'A sound for the end of focus and another for the end of a break, your own files, volume with preview.' },
  { light: lookLight, dark: lookDark, title: 'Appearance', text: 'Theme, focus color, break color and language. Every change shows immediately, Cancel puts it back.' },
  { light: systemLight, dark: systemDark, title: 'System', text: 'Notifications, pop-up on phase end, always on top, tray behaviour, start with Windows.' },
];
---

<section id="screens" class="border-t border-line bg-card dark:border-line-dark dark:bg-card-dark">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-break-deep uppercase dark:text-break">Settings</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">Four pages, and you will rarely open them</h2>
      <p class="mt-4 text-lg text-ink-muted text-pretty dark:text-ink-muted-dark">
        The day-to-day knobs live on the main window. Settings are for the things you decide once.
      </p>
    </div>

    <div class="mt-14 grid gap-10 sm:grid-cols-2">
      {pages.map((p) => (
        <figure>
          <Shot light={p.light} dark={p.dark} alt={`Settings window, ${p.title} page`} width={600} rounded="rounded-2xl" class="w-full" />
          <figcaption class="mt-5">
            <span class="font-semibold tracking-tight">{p.title}</span>
            <span class="text-ink-muted dark:text-ink-muted-dark"> · {p.text}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
