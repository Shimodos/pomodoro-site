---
// A 2x screenshot of the app that follows the site theme: light image by day, dark by night.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  width: number; // CSS width at 1x; the 2x variant comes from the source
  class?: string;
  loading?: 'lazy' | 'eager';
  rounded?: string;
}

const { light, dark, alt, width, class: className = '', loading = 'lazy', rounded = 'rounded-xl' } = Astro.props;
const frame = `${rounded} ring-1 ring-black/8 shadow-[0_30px_60px_-20px_rgba(0,0,0,0.25)] dark:ring-white/10 dark:shadow-[0_30px_60px_-20px_rgba(0,0,0,0.7)]`;
---

<Image
  src={light}
  alt={alt}
  width={width}
  densities={[1, 2]}
  loading={loading}
  class:list={[frame, className, dark && 'dark:hidden']}
/>
{dark && (
  <Image
    src={dark}
    alt={alt}
    width={width}
    densities={[1, 2]}
    loading={loading}
    class:list={[frame, className, 'hidden dark:block']}
  />
)}
