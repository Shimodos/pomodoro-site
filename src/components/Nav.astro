---
import Icon from './Icon.astro';

const links = [
  ['#features', 'Features'],
  ['#how', 'How it works'],
  ['#screens', 'Screenshots'],
  ['#faq', 'FAQ'],
];
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/80 backdrop-blur-md dark:border-line-dark/70 dark:bg-paper-dark/80">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-6">
    <a href="#top" class="flex items-center gap-2.5 font-semibold tracking-tight">
      <span class="inline-block size-3 rounded-full bg-focus"></span>
      Pomodoro
    </a>

    <nav class="hidden items-center gap-6 text-sm text-ink-muted md:flex dark:text-ink-muted-dark">
      {links.map(([href, label]) => (
        <a href={href} class="transition hover:text-ink dark:hover:text-ink-dark">{label}</a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-full text-ink-muted transition hover:bg-card hover:text-ink dark:text-ink-muted-dark dark:hover:bg-card-dark dark:hover:text-ink-dark"
        aria-label="Toggle dark mode"
      >
        <Icon name="sun" size={18} class="hidden dark:block" />
        <Icon name="moon" size={18} class="dark:hidden" />
      </button>
      <a
        href="https://github.com/Shimodos/PomodoroTimer"
        class="grid size-9 place-items-center rounded-full text-ink-muted transition hover:bg-card hover:text-ink dark:text-ink-muted-dark dark:hover:bg-card-dark dark:hover:text-ink-dark"
        aria-label="GitHub repository"
      >
        <Icon name="github" size={20} />
      </a>
      <a
        href="#download"
        class="ml-1 inline-flex h-9 items-center gap-2 rounded-full bg-ink px-4 text-sm font-medium text-white transition hover:bg-black dark:bg-ink-dark dark:text-ink dark:hover:bg-white"
      >
        <Icon name="download" size={16} />
        Download
      </a>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('theme-toggle');
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {
      /* private mode: the choice just doesn't persist */
    }
  });
</script>
